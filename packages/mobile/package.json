{
  "name": "@abyssal/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:debug": "expo run:android --variant debug",
    "build:android:release": "expo run:android --variant release",
    "build:android:store": "npx --yes eas-cli build --platform android --profile production --non-interactive",
    "build:ios:debug": "expo run:ios --configuration Debug",
    "build:ios:release": "expo run:ios --configuration Release",
    "build:ios:store": "npx --yes eas-cli build --platform ios --profile production --non-interactive",
    "web": "expo start --web",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.25",
    "axios": "1.15.1",
    "expo": "~54.0.33",
    "expo-blur": "^55.0.14",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "babel-jest": "^30.3.0",
    "eas-cli": "18.9.1",
    "jest": "^30.3.0"
  }
}
